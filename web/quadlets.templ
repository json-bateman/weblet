
package web

templ QuadletsPage(runningServices []string) {
	@Layout("Quadlets", CommitHash) {
		<main>
			<h3 class="mb-4">Quadlet Information</h3>
			<h4 class="text-muted mb-4">Running Quadlet Services</h4>
			if len(runningServices) == 0 {
				<p class="text-muted">No Quadlet services currently running</p>
			} else {
				<ul class="list-group list-group-flush mb-3" style="max-width: 400px;">
					for _, name := range runningServices {
						<li class="list-group-item">{ name }</li>
					}
				</ul>
			}
			<h4 class="fs-6 text-muted">Common Systemctl commands</h4>
			<pre class="p-3 rounded border bg-body-secondary" style="max-width: 550px;"><code class="language-bash">systemctl daemon-reload
systemctl restart { "<service-name>.service" }</code></pre>
		</main>
	}
}
