package web

import (
	"fmt"
	"strings"
)

templ osLogo(osName string) {
	switch  {
		case strings.Contains(strings.ToLower(osName), "centos"):
			<img src={ StaticPath("images/os/centos.png") } alt="CentOS" width="24" height="24"/>
		case strings.Contains(strings.ToLower(osName), "nixos"):
			<img src={ StaticPath("images/os/nixos.png") } alt="NixOS" width="24" height="24"/>
		case strings.Contains(strings.ToLower(osName), "darwin") || strings.Contains(strings.ToLower(osName), "mac"):
			<img class="svg" src={ StaticPath("icons/apple.svg") } alt="macOS" width="24" height="24"/>
		default:
			<img class="svg" src={ StaticPath("icons/linux.png") } alt="macOS" width="24" height="24"/>
	}
}

templ Home(info ServerInfo) {
	@Layout("/home", CommitHash) {
		<main data-init={ fmt.Sprintf("@get('/sse')") }>
			<h1>{ info.Name }</h1>
			@ServerInfoCards(info)
		</main>
	}
}

templ ServerInfoCards(info ServerInfo) {
	<section>
		<div class="d-flex gap-2 align-items-center">
			Running
			<img src={ StaticPath("images/go-logo-blue.png") } alt="Goroutines" width="60" height="24"/>
		</div>
		<div class="d-flex gap-3 text-muted small mb-3">
			<span>Version: { info.GoVersion[:8] }</span>
			<span>Goroutines: { fmt.Sprint(info.Goroutines) }</span>
		</div>
		<div class="row g-3">
			<div class="col-12 col-lg-6">
				<div class="card h-100">
					<div class="card-header d-flex justify-content-between align-items-end">
						<div class="d-flex gap-2 align-items-center">
							<img class="svg" width="40px" height="40px" src={ StaticPath("icons/server.svg") } alt="Server time"/>
							<h3 class="fs-5 mb-0">Server Information</h3>
						</div>
						<span>{ info.Now }</span>
					</div>
					<ul class="list-group list-group-flush">
						<li class="list-group-item d-flex justify-content-between align-items-center">
							<span class="d-flex gap-2 align-items-center fw-medium">
								@osLogo(info.OS)
								Operating System
							</span>
							<span class="text-truncate">{ info.OS }</span>
						</li>
						<li class="list-group-item d-flex justify-content-between align-items-center">
							<span class="d-flex gap-2 align-items-center fw-medium">
								<img src={ StaticPath("images/Linux.png") } alt="Linux" width="24" height="24"/>
								Kernel
							</span>
							<span class="text-truncate">{ info.Kernel }</span>
						</li>
						<li class="list-group-item d-flex justify-content-between align-items-center">
							<span class="d-flex gap-2 align-items-center fw-medium">
								<img src={ StaticPath("images/cpu.png") } alt="Architecture" width="24" height="24"/>
								Architecture
							</span>
							<span class="text-truncate">{ info.Arch }</span>
						</li>
						<li class="list-group-item d-flex justify-content-between align-items-center">
							<span class="d-flex gap-2 align-items-center fw-medium">
								<img class="svg" src={ StaticPath("icons/clock.svg") } alt="uptime" width="24" height="24"/>
								Uptime
							</span>
							<span>{ info.Uptime }</span>
						</li>
					</ul>
				</div>
			</div>
			<div class="col-12 col-lg-6">
				<div class="card h-100">
					<div class="card-header d-flex justify-content-between align-items-end">
						<div class="d-flex gap-2 align-items-center">
							<img class="svg" src={ StaticPath("icons/cpu.svg") } alt="Resources" width="40" height="40"/>
							<h3 class="fs-5 mb-0">Resources</h3>
						</div>
					</div>
					<div class="card-body">
						<div class="d-flex flex-wrap gap-2 mb-3">
							<div class="stat-tile">
								@progressBar("CPU Used", int(info.CPUPercent), fmt.Sprintf("%.0f%%", info.CPUPercent))
							</div>
							<div class="stat-tile">
								@progressBar(
									"Memory Used",
									int(100-(100*info.MemInfo.MemFree/info.MemInfo.MemTotal)),
									fmt.Sprintf("%.2f GiB of %.2f GiB", info.MemInfo.MemTotal-info.MemInfo.MemFree, info.MemInfo.MemTotal),
								)
							</div>
							<div class="stat-tile">
								@progressBar(
									"Disk Used",
									int(100-(100*info.DiskInfo.Free/info.DiskInfo.Total)),
									fmt.Sprintf("%.2f GiB of %.2f GiB", info.DiskInfo.Total-info.DiskInfo.Free, info.DiskInfo.Total),
								)
							</div>
						</div>
						if len(info.CoreUsage) > 0 {
							<h4 class="text-muted fs-6">Cores</h4>
							<div class="d-flex flex-wrap gap-2">
								for _, core := range info.CoreUsage {
									<div class="stat-tile compact">
										@progressBar(core.Name, int(core.Percent), "")
									</div>
								}
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	</section>
}
