package web

import "strings"

templ BrandLogo(osName string) {
	switch  {
		case strings.Contains(strings.ToLower(osName), "darwin") || strings.Contains(strings.ToLower(osName), "mac"):
			<div class="d-flex align-items-center gap-3">
				<img class="svg" src={ StaticPath("icons/apple.svg") } alt="macOS" width="48" height="48"/>
			</div>
		case strings.Contains(strings.ToLower(osName), "centos"):
			<div class="d-flex align-items-center gap-3">
				<img src={ StaticPath("images/centos-stream.png") } alt="CentOS Stream" width="163" height="48"/>
			</div>
		case strings.Contains(strings.ToLower(osName), "nixos"):
			<div class="d-flex align-items-center gap-3">
				<img src={ StaticPath("images/os/nixos.png") } alt="NixOS" width="48" height="48"/>
			</div>
		default:
			<div class="d-flex align-items-center gap-3">
				<img src={ StaticPath("images/linux.png") } alt="linux" width="163" height="48"/>
			</div>
	}
}

templ ShortcutsDialog() {
	<div
		id="shortcuts-overlay"
		class="modal d-none"
		data-class="{'d-block': $shortcutsOpen, 'd-none': !$shortcutsOpen}"
	>
		<div
			id="shortcuts-dialog"
			class="modal-dialog modal-dialog-centered"
			role="dialog"
			aria-modal="true"
			aria-labelledby="shortcuts-title"
			data-on:click__outside="!evt.target.closest('#shortcuts-toggle') && ($shortcutsOpen = false)"
			data-on:keydown__window="evt.key === 'Escape' && ($shortcutsOpen = false)"
		>
			<div class="modal-content">
				<div class="modal-header">
					<h3 class="modal-title fs-5" id="shortcuts-title">Keyboard Shortcuts</h3>
					<button
						type="button"
						class="btn-close"
						aria-label="Close"
						data-on:click="$shortcutsOpen = false"
					></button>
				</div>
				<div class="modal-body">
					<table class="table table-borderless mb-0">
						<tbody>
							<tr>
								<td class="w-25"><kbd>t</kbd></td>
								<td>Toggle light / dark theme</td>
							</tr>
							<tr>
								<td><kbd>s</kbd></td>
								<td>Toggle the sidebar</td>
							</tr>
							<tr>
								<td><kbd>?</kbd></td>
								<td>Open / close this dialog</td>
							</tr>
							<tr>
								<td><kbd>Esc</kbd></td>
								<td>Close this dialog</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
}

templ Layout(title, commitHash string) {
	<!DOCTYPE html>
	<html
		data-signals="{theme: localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')}"
		data-attr:data-bs-theme="$theme"
		data-effect="localStorage.setItem('theme', $theme)"
		data-on:keydown__window="hotkey(evt, 't') && ($theme = $theme === 'dark' ? 'light' : 'dark')"
		data-syntax-theme="gruvbox"
		lang="en"
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="icon" type="image/png" href={ StaticPath("images/favicon.png") }/>
			<!-- Need this IIFE to  run before CSS loads, prevents theme flash since D* is deferred with type="module" -->
			<script>
                    (function() {
                        const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                        document.documentElement.setAttribute('data-bs-theme', theme);
                    })();
                     // True when `key` was pressed bare: no modifiers &
                     // not while typing in a form field. Shared by all data-on:keydown hotkeys.
                     window.hotkey = (evt, key) =>
                        evt.key === key &&
                        !evt.ctrlKey && !evt.metaKey && !evt.altKey &&
                        !evt.target.closest('input, textarea, select, [contenteditable]');
               </script>
			<link href={ StaticPath("css/main.css") } rel="stylesheet"/>
		</head>
		<datastar-inspector></datastar-inspector>
		<body data-signals="{sidebarOpen: false, shortcutsOpen: false}">
			<div id="app-shell">
				<aside
					id="sidebar"
					data-class="{open: $sidebarOpen}"
					data-on:keydown__window="hotkey(evt, 's') && ($sidebarOpen = !$sidebarOpen)"
					data-on:click__outside="window.matchMedia('(max-width: 768px)').matches && !evt.target.closest('#sidebar-toggle') && ($sidebarOpen = false)"
				>
					<nav id="sidebar-nav" class="nav flex-column">
						<a class="nav-link" href={ templ.SafeURL(HomeUrl) }>/</a>
						<a class="nav-link" href={ templ.SafeURL(ProcessesUrl) }>/proc</a>
						<a class="nav-link" href={ templ.SafeURL(FilesUrl) }>Files</a>
						<a class="nav-link" href={ templ.SafeURL(QuadletsUrl) }>Quadlets</a>
					</nav>
					<div id="sidebar-footer">{ commitHash }</div>
				</aside>
				<div id="app-shell-main">
					<header
						id="masthead"
						data-on:keydown__window="hotkey(evt, '?') && ($shortcutsOpen = !$shortcutsOpen)"
					>
						<div class="d-flex align-items-center gap-3">
							<button
								id="sidebar-toggle"
								type="button"
								class="btn btn-outline-secondary btn-sm"
								aria-label="Toggle sidebar"
								data-on:click="$sidebarOpen = !$sidebarOpen"
							>☰</button>
							@BrandLogo(osPrettyName())
						</div>
						<div class="d-flex align-items-center gap-3">
							<div class="btn-group" role="group" aria-label="Color mode">
								<input type="radio" class="btn-check" name="theme-mode" id="theme-light" value="light" autocomplete="off" data-bind:theme/>
								<label class="btn btn-outline-primary" for="theme-light">
									<iconify-icon icon="material-symbols-light:sunny-rounded"></iconify-icon>
									<span class="d-none d-sm-inline">Light</span>
								</label>
								<input type="radio" class="btn-check" name="theme-mode" id="theme-dark" value="dark" autocomplete="off" data-bind:theme/>
								<label class="btn btn-outline-primary" for="theme-dark">
									<iconify-icon icon="material-symbols-light:moon-stars"></iconify-icon>
									<span class="d-none d-sm-inline">Dark</span>
								</label>
							</div>
							<button
								id="shortcuts-toggle"
								type="button"
								class="btn btn-outline-secondary btn-sm"
								aria-label="Keyboard shortcuts"
								aria-haspopup="dialog"
								data-on:click="$shortcutsOpen = true"
							>?</button>
						</div>
					</header>
					@ShortcutsDialog()
					<div class="page-shell">
						{ children... }
					</div>
				</div>
			</div>
		</body>
		<!-- Iconify -->
		<script src="https://cdn.jsdelivr.net/npm/iconify-icon@2"></script>
		<!-- Datastar Inspector-->
		<script type="module" src={ StaticPath("js/datastar-inspector.js") }></script>
		<!-- Datastar v1.0.2 -->
		<script type="module" src={ StaticPath("js/datastar.js") }></script>
		<!-- MicroLighter v2.1.0 (auto-runner: highlights pre > code[class^="language-"] on load) -->
		<script type="module" src={ StaticPath("js/microlighter/microlighter.min.js") }></script>
	</html>
}
